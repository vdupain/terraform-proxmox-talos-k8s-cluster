---
version: v1alpha1
machine:
  install:
    disk: ${install_disk}
  time:
    servers:
      - /dev/ptp0
  kernel:
    modules:
      - name: zfs
  features:
    kubePrism:
      enabled: true
      port: 7445
cluster:
  allowSchedulingOnControlPlanes: ${allow_scheduling_on_control_planes}
  network:
    cni:
      name: none
  proxy:
    disabled: true
  inlineManifests:
  - name: zfs-setup
    contents: |
      ${indent(6, zfs_setup)}
  - name: cilium
    contents: |
      ${indent(6, cilium)}
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: stable
%{ if vip_ip != null ~}
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: ${vip_ip}
link: ${vip_interface}
%{ endif ~}
